{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "rootDir": "src",
    "outDir": "dist",
    "module": "commonjs",
    "moduleDetection": "force",
    "isolatedModules": true,
  },
  "include": ["src"]
}